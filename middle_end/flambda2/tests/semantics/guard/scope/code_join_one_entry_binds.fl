(* MUST BE REFUSED: a code id is not in scope (asked for by R3). The handler
   k_c is entered from k_a and from k_b. Only k_b binds the code n_0 on the
   way. The handler of k_c allocates a closure of n_0. The run takes the way
   that binds (v = 1): both entries count all the same. No static binding
   stands in code or in the handler of a recursive continuation. *)
let o = %opaque (1) in
let v = %untag_imm (o) in
((switch v
    | 0 -> k_a
    | 1 -> k_b)
   where k_b =
     let code size(1) n_0 (x) my_closure &my_region my_depth -> k * e =
       cont k (x)
     in
     cont k_c (0)
   where k_a =
     cont k_c (0)
   where k_c (y) =
     let f = closure n_0 @n &toplevel in
     cont k_end (f))
  where k_end (r) =
    let $camlCode_join_one_entry_binds = Block 0 (r) in
    cont done ($camlCode_join_one_entry_binds)
