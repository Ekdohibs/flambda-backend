(* MUST PASS the check of static names. A handler of exceptions that is pushed
   and popped and that nothing raises to: a trap action names a continuation
   and applies none, so the body has no way to k_h, and its handler, which
   reads $S, is given all that the body binds. *)
let o = %opaque (1) in
((cont k_body push(k_h)
    where k_body =
      let $S = Block 0 (o) in
      cont k_c pop(k_h) (0))
   where k_h exn (e : val) =
     let x = %block_load.[`0`] ($S) in
     cont k_c (x))
  where k_c (r) =
    let $camlSymbol_pushed_handler_never_applied = Block 0 (r) in
    cont done ($camlSymbol_pushed_handler_never_applied)
