(* MUST PASS the check of static names. The partner of
   symbol_join_other_name_on_one_way.fl: $S is bound at the head of the body,
   on both ways to k_c, and $T on one of the two ways, and the handler of k_c
   reads $S alone. That one way lacks $T takes nothing from what every way
   binds. Given alone, the text passes the guard, and the compiler's Simplify
   stops with a fatal error at the binding of $T, as it does on
   ../static_in_arm.fl. *)
let o = %opaque (1) in
let v = %untag_imm (o) in
((let $S = Block 0 (o) in
  ((switch v
      | 0 -> k_a
      | 1 -> k_b)
     where k_b =
       let $T = Block 0 (o) in
       cont k_c (0)
     where k_a =
       cont k_c (0)))
   where k_c (y) =
     let x = %block_load.[`0`] ($S) in
     cont k_end (x))
  where k_end (r) =
    let $camlSymbol_join_other_name_on_one_way_not_mentioned = Block 0 (r) in
    cont done ($camlSymbol_join_other_name_on_one_way_not_mentioned)
