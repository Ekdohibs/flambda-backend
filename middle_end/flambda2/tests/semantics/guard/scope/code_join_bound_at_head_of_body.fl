(* MUST PASS the check of static names. The partner of
   code_join_one_entry_binds.fl (asked for by R3). The one binding of the code
   n_0 stands at the head of the body of the Let_cont of k_c, before the test,
   and inside that Let_cont: both arms enter k_c, whose handler allocates a
   closure of n_0. The code is in scope in the handler by what the body binds
   on every way to it, not by what is in scope around the Let_cont. *)
let o = %opaque (1) in
let v = %untag_imm (o) in
((let code size(1) n_0 (x) my_closure &my_region my_depth -> k * e =
    cont k (x)
  in
  ((switch v
      | 0 -> k_a
      | 1 -> k_b)
     where k_b =
       cont k_c (0)
     where k_a =
       cont k_c (0)))
   where k_c (y) =
     let f = closure n_0 @n &toplevel in
     cont k_end (f))
  where k_end (r) =
    let $camlCode_join_bound_at_head_of_body = Block 0 (r) in
    cont done ($camlCode_join_bound_at_head_of_body)
