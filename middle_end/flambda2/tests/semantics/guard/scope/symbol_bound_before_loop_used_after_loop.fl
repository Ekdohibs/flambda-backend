(* MUST PASS the check of static names. $S is bound in the body of the Let_cont
   of k_after, on the one way into the loop k_loop; the loop goes round once
   more and leaves to k_after, whose handler reads $S. What is bound on every
   way into a loop is bound on every way out of it. *)
let o = %opaque (1) in
(((let $S = Block 0 (o) in
   cont k_loop (0))
    where rec k_loop (i) =
      let more = %int_comp.`lt` (i, 1) in
      (switch more
         | 0 -> k_after (i)
         | 1 -> k_next
         where k_next =
           let i2 = %int_barith.`add` (i, 1) in
           cont k_loop (i2)))
   where k_after (n) =
     let x = %block_load.[`0`] ($S) in
     let sum = %int_barith.`add` (n, x) in
     cont k_end (sum))
  where k_end (r) =
    let $camlSymbol_bound_before_loop_used_after_loop = Block 0 (r) in
    cont done ($camlSymbol_bound_before_loop_used_after_loop)
