(* MUST BE REFUSED: a code id is not in scope. As
   code_join_one_entry_binds.fl, with another kind of mention: the handler of
   k_c calls the code n_0 directly, on the closure that it is given, and
   allocates nothing. Only k_b binds n_0 (and makes the closure); k_a gives
   k_c a number. The run takes the way that binds (v = 1). *)
let o = %opaque (1) in
let v = %untag_imm (o) in
((switch v
    | 0 -> k_a
    | 1 -> k_b)
   where k_b =
     let code size(1) n_0 (x) my_closure &my_region my_depth -> k * e =
       cont k (x)
     in
     let f = closure n_0 @n &toplevel in
     cont k_c (f)
   where k_a =
     cont k_c (0)
   where k_c (y) =
     apply direct(n_0 &toplevel) y (5) -> k_end * error)
  where k_end (r) =
    let $camlCode_join_one_entry_binds_called_directly = Block 0 (r) in
    cont done ($camlCode_join_one_entry_binds_called_directly)
