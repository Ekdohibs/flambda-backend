(* MUST PASS the check of static names, by the rule for a handler that the
   body has no way to: it is given all that the body binds. k_dead is never
   applied; its handler reads $S, which one arm of the body binds. The body is
   live: it goes on to k_c on both arms. Given alone, the text passes the
   guard, and the compiler's Simplify, which takes a static binding at the
   toplevel of a unit only, stops with a fatal error, as it does on
   ../static_in_arm.fl. *)
let o = %opaque (1) in
let v = %untag_imm (o) in
(((switch v
     | 0 -> k_c (0)
     | 1 -> k_b)
    where k_b =
      let $S = Block 0 (o) in
      cont k_c (1))
   where k_dead (z) =
     let x = %block_load.[`0`] ($S) in
     cont k_c (x))
  where k_c (r) =
    let $camlSymbol_handler_never_entered = Block 0 (r) in
    cont done ($camlSymbol_handler_never_entered)
