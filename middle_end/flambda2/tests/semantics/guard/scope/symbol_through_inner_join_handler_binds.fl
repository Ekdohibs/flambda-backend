(* MUST PASS the check of static names. The partner of
   symbol_through_inner_join_one_entry_binds.fl: it is the handler of k_m,
   through which every way to k_c goes, that binds $S. *)
let o = %opaque (1) in
let v = %untag_imm (o) in
(((switch v
     | 0 -> k_a
     | 1 -> k_b)
    where k_b =
      cont k_m (0)
    where k_a =
      cont k_m (0)
    where k_m (z) =
      let $S = Block 0 (o) in
      cont k_c (z))
   where k_c (y) =
     let x = %block_load.[`0`] ($S) in
     cont k_end (x))
  where k_end (r) =
    let $camlSymbol_through_inner_join_handler_binds = Block 0 (r) in
    cont done ($camlSymbol_through_inner_join_handler_binds)
