(* As statics_place_loop_handler.fl, but the static binding is in a handler
   inside the loop that runs once in the whole run (when i = 0). The rule of
   place is a test of the text and refuses it all the same: a handler in a
   loop is in the loop. *)
cont k/10 (0, 0)
  where rec k/10 (i/2 : imm tagged, first/3 : val) =
    let is_first/4 = %int_comp.lt (i/2, 1) in
    ((switch is_first/4
        | 0 -> k/12 (first/3)
        | 1 -> k/14
        where k/14 =
          let $Cell = Block 0 (i/2) in
          cont k/12 ($Cell))
       where k/12 (kept/5 : val) =
         let more/6 = %int_comp.lt (i/2, 2) in
         (switch more/6
            | 0 -> k/11 (kept/5)
            | 1 -> k/13
            where k/13 =
              let next/7 = %int_barith.add (i/2, 1) in
              cont k/10 (next/7, kept/5)))
  where k/11 (kept/8 : val) =
    let result/9 = %block_load.[`0`] (kept/8) in
    let $camlStatics_place_handler_in_loop_run_once = Block 0 (result/9) in
    cont done ($camlStatics_place_handler_in_loop_run_once)
