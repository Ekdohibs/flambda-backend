(* A Block_set marked as an initialisation. The conversion refuses it: the
   unit is not checked. No place where the front end makes a Block_set with
   that mark was found; a text can have one. The initialising store that the
   compiler makes for a function whose recursion is in the tail of a
   constructor is an Array_set marked as an initialisation, with a block as
   what it writes to; the conversion refuses that primitive too
   (heap_array_set_initialising.fl). *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let r = %block.mut.[`0`].my_alloc_region (0) in
  let c = %opaque (r) in
  let w = %block_set.`imm`.init.[`0`] (c, x) in
  let a = %block_load.mut.[`0`] (c) in
  cont k (a)
in
let $camlHeap_store_initialising__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlHeap_store_initialising__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlHeap_store_initialising = Block 0 (r) in
    cont done ($camlHeap_store_initialising)
