(* An Array_set marked as an initialisation. The compiler makes one for a
   function whose recursion is in the tail of a constructor, where what it
   writes to is a block; this control writes to an array. The conversion
   refuses every store marked as an initialisation, by this primitive as by
   Block_set (heap_store_initialising.fl): the unit is not checked. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let r = %array.mut.my_alloc_region (0, 1) in
  let c = %opaque (r) in
  let w = %array_set.value.init (c, 0, x) in
  let a = %array_load.mut (c, 0) in
  cont k (a)
in
let $camlHeap_array_set_initialising__work_1 =
  closure work_0 @work &toplevel
in
apply direct(work_0 &toplevel)
  ($camlHeap_array_set_initialising__work_1 : _ -> imm tagged) (41)
    -> k1 * error
  where k1 (r : imm tagged) =
    let $camlHeap_array_set_initialising = Block 0 (r) in
    cont done ($camlHeap_array_set_initialising)
