(* The term before of a control of the guess of liftings (see dune), written
   by hand. A closure that nothing uses holds a boxed number in a value slot,
   and the module has that boxed number and a block of two constants. *)
(let code size(12)
       f_0 (n/45 : int64 boxed)
         my_closure/46 &my_alloc_region/47 my_depth/48
         -> k/12 * k/13
         : imm tagged =
   let limit/50 = %project_value_slot.[f].[limit] (my_closure/46) in
   let prim/51 = %unbox_num.`int64` (limit/50) in
   let prim/52 = %unbox_num.`int64` (n/45) in
   let prim/53 = %int_barith.`int64`.add (prim/52, prim/51) in
   let prim/56 = %num_conv.[`int64`].[`imm`] (prim/53) in
   let sum/57 = %tag_imm (prim/56) in
   cont k/12 (sum/57)
 in
 let limit/62 = %box_num.`int64`.`toplevel` (1000L) in
 let f/63 = closure f_0 @f &toplevel with { limit = limit/62 } in
 let pair/64 = %block.[`0`].`toplevel` (1, 2) in
 let Pmakeblock/59 = %block.[`0`].`toplevel` (limit/62, pair/64) in
 cont k/11 (Pmakeblock/59))
  where k/11 define_root_symbol (module_block/43) =
    let field_0/44 = %block_load.tag[`0`].`size`[`2`].[`0`] (module_block/43)
    in
    let field_1/45 = %block_load.tag[`0`].`size`[`2`].[`1`] (module_block/43)
    in
    let $camlBox_in_slot_kept_by_let = Block 0 (field_0/44, field_1/45) in
    cont done ($camlBox_in_slot_kept_by_let)
