(* For the check of regions: the body of a [try] makes a block in the region
   around the [try] and raises it. The block was made while the region of the
   [try] was the newest, so the handler's [%end_try_region] frees it, though
   the region that it names is still open; the handler then reads it, and the
   check fails there, of both terms (decisions D44, D45 and D48). *)
let code inline(never) loopify(never) size(30)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let try_rgn = %begin_try_region () in
  (cont kbody push(khandler)
     where kbody =
       let p = %block.[`0`].my_alloc_region.local[rgn] (x, 1) in
       let q = %opaque (p) in
       cont khandler pop(regular khandler) (q)
     where khandler exn (ex : val) =
       let u1 = %end_try_region (try_rgn) in
       let a = %block_load.[`0`] (ex) in
       let u2 = %end_region (rgn) in
       cont k (a))
in
let $camlRegion_try_local_exception__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_try_local_exception__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_try_local_exception = Block 0 (r) in
    cont done ($camlRegion_try_local_exception)
