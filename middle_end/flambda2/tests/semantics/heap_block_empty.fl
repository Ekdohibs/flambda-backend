(* A block that can change and has no field, made as the term runs. The
   compiler makes no such allocation: the front end makes a static block of an
   empty one, and the backend stops on one. The conversion refuses it: the
   unit is not checked. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let r = %block.mut.[`0`].my_alloc_region () in
  let c = %opaque (r) in
  cont k (x)
in
let $camlHeap_block_empty__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlHeap_block_empty__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlHeap_block_empty = Block 0 (r) in
    cont done ($camlHeap_block_empty)
