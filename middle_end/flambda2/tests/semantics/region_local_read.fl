(* For the check of regions: a function makes a block in a region of its own,
   reads it while the region is open, and ends the region. [%opaque] keeps
   Simplify from reading the block itself, so the block and the region are
   still there afterwards. The check passes of both terms. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %block.[`0`].my_alloc_region.local[rgn] (x, 1) in
  let q = %opaque (p) in
  let a = %block_load.[`0`] (q) in
  let b = %block_load.[`1`] (q) in
  let s = %int_barith.add (a, b) in
  let u1 = %end_region (rgn) in
  cont k (s)
in
let $camlRegion_local_read__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_local_read__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_local_read = Block 0 (r) in
    cont done ($camlRegion_local_read)
