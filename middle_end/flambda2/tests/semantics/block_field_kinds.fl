(* A function makes a block that cannot change, and the text says more of its
   fields than that each is any value: the first is an immediate, and the
   second an immediate that may be null. The model has no such kinds, and the
   conversion drops that much of the kind of a field, as it does of a
   parameter (decision D25, which is open: this is provisional). So the unit
   is run and validated. A tool that takes a block only where the kind of
   every field is that of any value says of this unit that it is not checked,
   which is not what the expected file says. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : [ 0 of val * val ] =
  let p = %block.[`0`].my_alloc_region (x : imm tagged, 2 : imm tagged?) in
  cont k (p)
in
let $camlBlock_field_kinds__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlBlock_field_kinds__work_1 : _ -> [ 0 of val * val ])
    (41) -> k1 * error
  where k1 (r : [ 0 of val * val ]) =
    let $camlBlock_field_kinds = Block 0 (r) in
    cont done ($camlBlock_field_kinds)
