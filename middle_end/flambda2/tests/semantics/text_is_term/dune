;; Controls of the driver that checks that the text of a term, read back, is
;; the term (../../tools/textisterm/fltextisterm.ml). The driver is built in
;; the main context only, so the rules are for that context.
;;
;; variant_two_orders, ../ocaml/variant_two_blocks: units whose term has the
;; kind of a variant built with its constructors in another order than the
;; reader of texts builds it. The text is the term.
;;
;; first_of_a_pair: a unit whose term has a kind that says of a value that it
;; may be null, where the text writes a kind. The text is the term.
;;
;; call_of_unknown_function: the arity of the arguments of the call is not
;; one plain value for each argument, and the text writes it. The text is the
;; term.
;;
;; block_of_an_immediate: the kinds of the fields of a block that is made are
;; not all that of any value, and the text writes them. The text is the term.
;;
;; checked_division: a continuation of the unit is cold, and the text says
;; so. The text is the term.
;;
;; functor_of_a_module: code of the unit is that of a functor, and the text
;; says so. The text is the term.
;;
;; unboxed_pair_parameter: code has a parameter that is an unboxed product, and
;; the text writes its components as a group. The text is the term.
;;
;; c_call: a unit with a call of a C function. The text is the term.
;;
;; length_of_bytes: the length of a byte sequence, which the text writes
;; "%bytes_length". The text is the term.
;;
;; call_not_in_tail_position: a call that the source marks [@nontail], and the
;; text says so of the call. The text is the term.
;;
;; match_on_a_known_constructor: the term has an invalid expression, and the
;; text writes its kind. The text is the term.
;;
;; comparison_of_two_floats: the comparison of two floats that gives -1, 0 or
;; 1, which the text writes "%float_comp.qmark". The text is the term.
;;
;; test_for_an_immediate_of_any_value: the test for an immediate that works on
;; any value, which the text writes "%is_int.generic". The text is the term.
;;
;; identity_for_the_middle_end: an identity that only the middle end does not
;; see through, which the text writes "%opaque.middle_end_only". The text is
;; the term.
;;
;; first_write_of_a_cell: a write into an array of values that is the first
;; write of the field and not an assignment, which the text writes
;; "%array_set.values.value.init". The text is the term.
;;
;; vector_read_of_an_array_of_integers: a read of an array of immediates that
;; gives a 128-bit vector, which the text writes "%array_load.`imm`.`vec128`".
;; The text is the term.
;;
;; vector_write_into_an_array_of_integers: a write into an array of immediates
;; that takes a 128-bit vector, which the text writes
;; "%array_set.`imm`.`vec128`". The text is the term.
;;
;; marks_of_a_c_call: four calls of C functions, of a builtin, of one with no
;; effects, of one with no coeffects and of one whose only effects are those
;; of an allocation, which the text writes "ccall builtin", "ccall no_effects",
;; "ccall no_coeffects" and "ccall only_generative_effects mutable". The text
;; is the term.
;;
;; call_that_is_a_probe: two probes, the second enabled from the start. In
;; the call of the handler of each the text writes that it is a probe, with
;; its name: probe("p") and probe("q" enabled_at_init). The text is the term.
;;
;; direct_call_in_classic_mode: compiled with -Oclassic, a direct call that
;; has no callee, whose arities the text writes with a blank in the place of
;; the callee. The text is the term.
;;
;; unrolled_call_in_classic_mode: compiled with -Oclassic, a call marked
;; [@unrolled 3] whose attribute the term says is not used, which the text
;; writes after the number of the attribute. The text is the term.
;;
;; inlined_call_in_classic_mode: compiled with -Oclassic, two calls inlined
;; before Simplify, one of them marked [@inlined]: the text writes the
;; inlining attribute of the mark of each inlined body; the reader gives the
;; mark a stack of debugging information that is not empty; and the comparison
;; compares whether that stack is empty, and not what it holds. The text is the
;; term.
;;
;; unboxed_field_of_a_record: reads and writes of fields of a record that are
;; unboxed numbers, which the text writes with "flat[KIND]" for the kind of
;; the field, and a read of a field of the same record that is a value. The
;; text is the term.
;;
;; kind_of_a_record_with_an_unboxed_field: a parameter and a result whose kind
;; is that of a block with an unboxed field. The text writes the kinds of the
;; fields, from which the reader makes the shape of the block. The text is
;; the term.
;;
;; constant_record_with_an_unboxed_field: a static block with an unboxed
;; field, the kinds of whose fields the text writes after its tag. The text
;; is the term.
;;
;; parameters_of_small_unboxed_integers: parameters of the kinds of unboxed
;; 8-bit and 16-bit integers, which the reader takes. The text is the term.
;;
;; parameter_that_is_a_boxed_vector: a parameter of the kind of a boxed
;; 128-bit vector, which the reader takes. The text is the term.
;;
;; large_unboxed_integer: unboxed 64-bit and native integers of more than 63
;; bits, whose digits the reader reads as the suffix says. The text is the
;; term.
;;
;; string_that_ends_in_a_backslash: a string that ends in a backslash, before
;; another string. The reader takes a backslash with the character after it.
;; The text is the term.
;;
;; arrays_of_unboxed_products: reads, writes and lengths of arrays of unboxed
;; products, some of which hold a product. The reader reads the kind of such
;; an array in the order of the text. The text is the term.
;;
;; operations_of_effects: the seven operations of effects, each a call of a
;; kind of its own, which the text writes "effect(NAME OPERANDS)". The text
;; is the term.
;;
;; partial_application_of_unboxed_float: a closure that keeps an unboxed
;; float in a value slot. The text writes the kind of the slot where the code
;; reads it. The text is the term.
;;
;; call_of_code_of_another_unit: compiled with -Oclassic after other_unit.ml,
;; which is compiled first. The term has a direct call of code of that unit,
;; put there where a call of a function of it was inlined before Simplify.
;; The text names that code as it names code that the unit binds, and the
;; reader makes a new code ID of the unit being read for the name. The text is
;; not the term.
;;
;; closure_of_code_of_another_unit: the same, where the term has a closure of
;; code of the other unit. The reader stops on it. The text is not read back.
;;
;; recursive_function_called_from_its_closure: checked with -after-simplify,
;; on the term that Simplify returns. On the callee of a direct call that term
;; has a change of depth between two equal depths, which is not the identity
;; coercion (X3-8). The text writes it, and the reader reads a change of
;; depth. The text is the term.
;;
;; after_simplify_in_classic_mode: direct_call_in_classic_mode.ml, checked
;; with -after-simplify and compiled with -Oclassic. Simplify is not run, and
;; the driver says that nothing was checked.
;;
;; interface_only, type_error: the compiler does not reach the middle end.
;;
;; two_units, args_file, impl_attached, mlt: more than one implementation,
;; given as two files, in a file of arguments (-args=FILE), by two options
;; -impl=FILE, and as two files .mlt. The driver counts the implementations
;; that the compiler compiles, and says that nothing was checked.
;;
;; impl_attached_alone, mlt_alone: one implementation given in those two
;; ways. It is checked.
;;
;; config, config_var, depend: options for which the compiler prints
;; something and exits by itself with the status 0. The driver says that
;; nothing was checked, and exits with 2.
;;
;; print_interface: with -i the compiler prints the interface of the unit and
;; does not reach the middle end.

(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   variant_two_orders.output
   (run sh %{dep:run.sh} %{dep:../../tools/textisterm/fltextisterm.exe}
     %{dep:variant_two_orders.ml}))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (diff variant_two_orders.expected variant_two_orders.output)))

(rule
 (enabled_if
  (= %{context_name} "main"))
 (deps ../ocaml/variant_two_blocks.mli)
 (action
  (with-stdout-to
   variant_two_blocks.output
   (run sh %{dep:run.sh} %{dep:../../tools/textisterm/fltextisterm.exe}
     %{dep:../ocaml/variant_two_blocks.ml}))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (diff variant_two_blocks.expected variant_two_blocks.output)))

