(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   args_file.output
   (run sh %{dep:run.sh} %{dep:../../tools/textisterm/fltextisterm.exe}
     copy:%{dep:variant_two_orders.ml}:first.ml
     copy:%{dep:c_call.ml}:second.ml
     copy:%{dep:two_units.args}:two_units.args -args=two_units.args))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (diff args_file.expected args_file.output)))

