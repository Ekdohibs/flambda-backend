(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   two_units.output
   (run sh %{dep:run.sh} %{dep:../../tools/textisterm/fltextisterm.exe}
     %{dep:variant_two_orders.ml} %{dep:c_call.ml}))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
