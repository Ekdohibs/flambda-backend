  (diff config.expected config.output)))

(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   config_var.output
   (run sh %{dep:run.sh} %{dep:../../tools/textisterm/fltextisterm.exe}
     -config-var version %{dep:variant_two_orders.ml}))))

(rule
