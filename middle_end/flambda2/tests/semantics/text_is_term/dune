  (diff two_units.expected two_units.output)))

(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   config.output
   (run sh %{dep:run.sh} %{dep:../../tools/textisterm/fltextisterm.exe}
     -config %{dep:variant_two_orders.ml}))))

(rule
