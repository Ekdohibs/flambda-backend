(* A control of what the test tool prints where it does not run Simplify: no
   escape sequence of a terminal. This text is the term before of a pair
   under the option -after; name_in_a_refusal_after.fl is the term after. In
   the term after the end that is not a ghost is given the variable of the
   ghost region, so the conversion with regions kept refuses the pair, and
   the line of the check of regions gives the reason, which names that
   variable as the compiler prints it. The compiler colours the names that
   it prints unless that has been decided otherwise before the first is
   printed; in the tool the entry point through which it runs Simplify
   decides it ([Flambda2.flambda_to_flambda]), and here there is no such
   run. *)
let rgn = %begin_region () in
let grgn = %begin_ghost_region () in
let x = %opaque (41) in
let p = %block.[`0`].`toplevel`.local[rgn] (x, 1) in
let q = %opaque (p) in
let a = %block_load.[`0`] (q) in
let b = %block_load.[`1`] (q) in
let s = %int_barith.add (a, b) in
let u1 = %end_region (rgn) in
let u2 = %end_ghost_region (grgn) in
let $camlName_in_a_refusal = Block 0 (s) in
cont done ($camlName_in_a_refusal)
