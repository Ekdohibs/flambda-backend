(* For the check of regions: a block that can change is made in the outer of
   two regions, and a block of the inner region is stored in it. The value
   stored does not live as long as the cell: the check fails at the store, of
   both terms, with the fault of its own (decision D54). *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rout = %begin_region () in
  let h = %block.mut.[`0`].my_alloc_region.local[rout] (0) in
  let c = %opaque (h) in
  let rin = %begin_region () in
  let p = %block.[`0`].my_alloc_region.local[rin] (x, 1) in
  let q = %opaque (p) in
  let w = %block_set.lassign.[`0`] (c, q) in
  let u1 = %end_region (rin) in
  let u2 = %end_region (rout) in
  cont k (x)
in
let $camlRegion_cell_stores_shorter__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_cell_stores_shorter__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_cell_stores_shorter = Block 0 (r) in
    cont done ($camlRegion_cell_stores_shorter)
