(* For the check of regions: a block that can change is made in a region, a
   field of it is written, and the field is read while the region is open. On
   the machine of regions the block is a cell of the heap that the state lists
   with the mark of its region. The check passes of both terms. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %block.mut.[`0`].my_alloc_region.local[rgn] (0, 1) in
  let q = %opaque (p) in
  let w = %block_set.`imm`.[`0`] (q, x) in
  let a = %block_load.mut.[`0`] (q) in
  let b = %block_load.mut.[`1`] (q) in
  let s = %int_barith.add (a, b) in
  let u1 = %end_region (rgn) in
  cont k (s)
in
let $camlRegion_cell_read__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_cell_read__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_cell_read = Block 0 (r) in
    cont done ($camlRegion_cell_read)
