(* For the check of regions: a block in a region is compared with itself by
   [Phys_equal]. The comparison has no value on a local block, as it has none
   on a block of the heap (decision D19): a local block gets no identity from
   the symbol that names it in the machine of regions. So the run of the term
   before is undefined on both machines, and the check of regions says nothing
   of it. Simplify answers the comparison of a variable with itself, and the
   term after passes. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %block.[`0`].my_alloc_region.local[rgn] (x, 1) in
  let q = %opaque (p) in
  let same = %phys_eq (q, q) in
  let t = %tag_imm (same) in
  let u1 = %end_region (rgn) in
  cont k (t)
in
let $camlRegion_phys_equal_local__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_phys_equal_local__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_phys_equal_local = Block 0 (r) in
    cont done ($camlRegion_phys_equal_local)
