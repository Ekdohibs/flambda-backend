(* A static binding in the handler of a recursive continuation that runs three
   times (i = 0, 1, 2); the symbol of the first turn is kept and its field
   read after the loop. Refused by the rule of place
   (FlambdaWellFormedSpec.statics_outside_loops_and_code): the term is not
   given to Simplify. *)
cont k/10 (0, 0)
  where rec k/10 (i/2 : imm tagged, first/3 : val) =
    let $Cell = Block 0 (i/2) in
    let is_first/4 = %int_comp.lt (i/2, 1) in
    ((switch is_first/4
        | 0 -> k/12 (first/3)
        | 1 -> k/12 ($Cell))
       where k/12 (kept/5 : val) =
         let more/6 = %int_comp.lt (i/2, 2) in
         (switch more/6
            | 0 -> k/11 (kept/5)
            | 1 -> k/13
            where k/13 =
              let next/7 = %int_barith.add (i/2, 1) in
              cont k/10 (next/7, kept/5)))
  where k/11 (kept/8 : val) =
    let result/9 = %block_load.[`0`] (kept/8) in
    let $camlStatics_place_loop_handler = Block 0 (result/9) in
    cont done ($camlStatics_place_loop_handler)
