(* A tail call that an earlier fix of the unboxing made a call that is not
   in tail position. The unit is made by ../ocaml/from_ocaml.sh of

     external opaque : 'a -> 'a = "%opaque"
     external ( - ) : int -> int -> int = "%subint"
     external ( == ) : 'a -> 'a -> bool = "%eq"
     let r =
       let[@inline never] rec ping n = if n == 0 then 0 else pong (n - 1)
       and[@inline never] pong n = if n == 0 then 0 else ping (n - 1) in
       let f = if opaque true then ping else pong in
       let _ = f 3 in
       1

   with an interface that exports r. ping and pong are called at unknown
   arity through the join f, so neither can change its calling convention,
   and the result of neither has a use. Each calls the other in tail
   position. The earlier fix kept the parameter of the return continuation
   of each code with no use ([Keep { unused = true }]), and
   [make_apply_wrapper] gave it poison whatever the callee returned: the
   call returned to a wrapper, and was no longer in tail position (the same
   program with the standard library, ping and pong called with
   100_000_000, stopped on Stack_overflow). The fix proposed for the reaper
   passes a result that the callee keeps on as it is, as the compiler
   without a fix does, so that the call stays in tail position; the model,
   which transcribes it, rebuilds the unit as without the fix, and the last
   section is not printed. *)
