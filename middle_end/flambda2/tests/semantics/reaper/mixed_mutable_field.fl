(* A field read immutably at one type and mutably at another, under a GADT.
   The unit is made by ../ocaml/from_ocaml.sh of

     type r1 = { a : int * int }
     type r2 = { mutable b : int -> int }
     type _ w = A : r1 w | B : r2 w
     external opaque : 'a -> 'a = "%opaque"
     external ( + ) : int -> int -> int = "%addint"
     let[@inline never] f : type t. t w -> t -> int = fun w x ->
       match w with A -> (let (p, _) = x.a in p) | B -> x.b 3
     let[@inline never] g n = f A { a = (n, n) }
     let r = g (opaque 1) + g (opaque 2)

   with an interface that exports r. Field 0 of x is read immutably in the
   arm A, where the pair that it holds is unboxed, and mutably in the arm B,
   where it is called. The reaper names a field by its index and kind, not
   its mutability, so the two reads are of one field, which flows to both an
   unboxed and a kept variable. With unboxing, the compiler's analysis stops
   on it ("flows to both unboxed and non-unboxed variables",
   [mk_unboxed_fields] of unboxing_analysis.ml), and so does its reaper. The
   model does not stop: its tables pass its checks, and it unboxes the
   parameter x of f to its field 0, a value, and also the pair, read as
   [*match*] in the arm A, so that nothing is left to give f as that field.
   Its rebuild makes the call of f in g, and the arm A of f, [Invalid]: the
   unit returns 3, and the run of the model's rebuild is undefined. *)
