(* A block in a block: [make], which is not inlined, returns a block [q] whose
   field is a block [p] of its parameter and 8; the unit reads field 0 of [q],
   and field 0 of that. Both blocks are unboxed, [p] in [q], and [make]
   returns the one field that is read. *)
let code inline(never) size(9) make (x) my_closure &my_region my_depth
      -> k * e =
  let p = %block.[`0`].my_region (x, 8) in
  let q = %block.[`0`].my_region (p) in
  cont k (q)
in
let $Unbox_nested_block_make = closure make @make &toplevel in
let a = %opaque (7) in
apply direct(make &toplevel) $Unbox_nested_block_make (a) -> k1 * error
  where k1 (r) =
    let s = %block_load.[`0`] (r) in
    let y = %block_load.[`0`] (s) in
    let $camlUnbox_nested_block = Block 0 (y) in
    cont done ($camlUnbox_nested_block)
