(* A change of calling convention that needs a wrapper continuation: [f] does
   not read its second parameter, and its second result is read after the
   first call but not after the second. [f] loses the parameter and keeps the
   result; the continuation of the second call loses the parameter that
   receives it, so the call returns to a wrapper that drops it. *)
let code inline(never) size(5) f (x, unused) my_closure &my_region my_depth
      -> k * e : val * val =
  let y = %int_barith.`add` (x, 1) in
  cont k (y, x)
in
let $Cc_wrapper_f = closure f @f &toplevel in
let a = %opaque (1) in
let b = %opaque (2) in
apply direct(f &toplevel) ($Cc_wrapper_f : _ -> val * val) (a, b)
  -> k1 * error
  where k1 (r, s) =
    let rs = %int_barith.`add` (r, s) in
    apply direct(f &toplevel) ($Cc_wrapper_f : _ -> val * val) (rs, b)
      -> k2 * error
  where k2 (t, u) =
    let $camlCc_wrapper = Block 0 (t) in
    cont done ($camlCc_wrapper)
