(* For the check of regions: a region is given to a continuation as an
   argument, and the handler, which reads a local block, ends it. Both terms
   pass. Simplify deletes the end of a region that is a parameter of a
   continuation and that nothing else uses, so the term after ends nothing.
   The line does not say so (decision D48); the counts do
   (regions/region_param_ended_by_handler.counts, which the rules of that
   directory compare). *)
let code inline(never) loopify(never) size(30)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %block.[`0`].my_alloc_region.local[rgn] (x, 1) in
  let q = %opaque (p) in
  let c = %untag_imm (x) in
  (switch c
     | 0 -> j (rgn, q, 10)
     | 1 -> j (rgn, q, 20))
    where j (r : region, b : val, i : imm tagged) =
      let a = %block_load.[`0`] (b) in
      let u = %end_region (r) in
      let s = %int_barith.`add` (a, i) in
      cont k (s)
in
let $camlRegion_param_ended_by_handler__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_param_ended_by_handler__work_1 : _ -> imm tagged) (1) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_param_ended_by_handler = Block 0 (r) in
    cont done ($camlRegion_param_ended_by_handler)
