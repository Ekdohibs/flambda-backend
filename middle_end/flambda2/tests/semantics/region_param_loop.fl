(* For the check of regions: a region is given to a recursive continuation,
   which allocates a block in it at every turn and gives it on, and at last to
   the continuation that ends it. Both terms pass. As in
   region_param_ended_by_handler.fl, Simplify deletes the end, and the counts
   say so (regions/region_param_loop.counts). *)
let code inline(never) loopify(never) size(40)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  cont loop (rgn, 3, 0)
    where rec loop (r : region, i : imm tagged, acc : imm tagged) =
      let p = %block.[`0`].my_alloc_region.local[r] (i, acc) in
      let q = %opaque (p) in
      let a = %block_load.[`0`] (q) in
      let acc2 = %int_barith.`add` (acc, a) in
      let i2 = %int_barith.`sub` (i, 1) in
      let c = %int_comp.`lt` (i2, 1) in
      (switch c
         | 0 -> loop (r, i2, acc2)
         | 1 -> finish (r, acc2))
    where finish (r2 : region, res : imm tagged) =
      let u = %end_region (r2) in
      cont k (res)
in
let $camlRegion_param_loop__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_param_loop__work_1 : _ -> imm tagged) (1) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_param_loop = Block 0 (r) in
    cont done ($camlRegion_param_loop)
