(rule
 (enabled_if
  (= %{context_name} "main"))
 (deps
  %{ocamlopt}
  (glob_files %{ocaml_where}/*.cmi))
 (action
  (with-stdout-to
   library_function.says.out
   (run sh %{dep:says.sh} %{dep:../from_ocaml.sh} %{ocamlopt}
    %{dep:library_function.ml} %{ocaml_where}))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (diff library_function.says library_function.says.out)))

