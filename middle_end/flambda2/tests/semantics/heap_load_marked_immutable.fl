(* A block that can change has two fields, and the second is read by a load
   that is not marked mutable: what the front end makes of a record with a
   field that can change and one that cannot, at a read of the second. In the
   model such a load has no value (decision D52, which is open), so the run of
   the term before is undefined, and the validation says nothing of the unit:
   the last line says so. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let r = %block.mut.[`0`].my_alloc_region (0, 1) in
  let c = %opaque (r) in
  let w = %block_set.`imm`.[`0`] (c, x) in
  let a = %block_load.mut.[`0`] (c) in
  let b = %block_load.[`1`] (c) in
  let s = %int_barith.add (a, b) in
  cont k (s)
in
let $camlHeap_load_marked_immutable__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlHeap_load_marked_immutable__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlHeap_load_marked_immutable = Block 0 (r) in
    cont done ($camlHeap_load_marked_immutable)
