(* The term before of the controls guarded_* (see dune). A C function is
   called in the arm of a test that the run does not take: [a] is 1, so [c]
   is 0 and the run goes to [skip]; the test is of an opaque value, so that
   nothing folds it. The run returns and does not reach the call. *)
let a = %opaque (1) in
let c = %int_comp.`lt` (a, 1) in
((switch c
    | 0 -> skip
    | 1 -> call)
   where call =
     (apply ccall &toplevel
        ($`*extern*`.c_one : val? * val? -> val?) (a, 1) -> returned * error
        where returned (r) =
          let s = %int_barith.`add` (r, 1) in
          cont leave (s))
   where skip =
     cont leave (7))
  where leave (v) =
    let $camlGuarded = Block 0 (v) in
    cont done ($camlGuarded)
