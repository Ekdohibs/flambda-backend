(* The term after of the control guarded_generative_mutable (see dune),
   written by hand: Simplify did not make it. It is guarded_generative.fl but
   for one thing: the call says that what the C function makes is mutable. *)
let a = %opaque (1) in
let c = %int_comp.`lt` (a, 1) in
((switch c
    | 0 -> skip
    | 1 -> call)
   where call =
     (apply ccall only_generative_effects mutable &toplevel
        ($`*extern*`.c_one : val? * val? -> val?) (a, 1) -> returned * error
        where returned (r) =
          let s = %int_barith.`add` (r, 1) in
          cont leave (s))
   where skip =
     cont leave (7))
  where leave (v) =
    let $camlGuarded_generative = Block 0 (v) in
    cont done ($camlGuarded_generative)
