(* For the check of regions: region_cell_read.fl with the region ended before
   the block is read. The block is a cell whose frame is gone: a load evaluates
   its location, and the check fails there, of both terms (decision D45). The
   run that drops regions returns 42 all the same. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %block.mut.[`0`].my_alloc_region.local[rgn] (0, 1) in
  let q = %opaque (p) in
  let w = %block_set.`imm`.[`0`] (q, x) in
  let u1 = %end_region (rgn) in
  let a = %block_load.mut.[`0`] (q) in
  let b = %block_load.mut.[`1`] (q) in
  let s = %int_barith.add (a, b) in
  cont k (s)
in
let $camlRegion_cell_read_after_end__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_cell_read_after_end__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_cell_read_after_end = Block 0 (r) in
    cont done ($camlRegion_cell_read_after_end)
