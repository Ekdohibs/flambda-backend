(* The way of an exception: a call that raises, in the body of a try. The
   symbol is bound after the call, in the handler that the call returns to,
   and is mentioned in the exception handler of the call. A call counts as a
   way to its exception continuation with what is bound before it, so the
   check of static names refuses the unit. *)
let $Bucket = Block 0 (1) in
let code inline(never) loopify(never) size(10)
      f_0 (x/67 : imm tagged)
        my_closure/68 &my_alloc_region/69 my_depth/70
        -> k/22 * k/23
        : val =
  cont k/23 pop(regular k/23) ($Bucket)
in
let $F = closure f_0 @f &toplevel in
let a/1 = %opaque (3) in
(((cont k/30 push(k/31)
     where k/30 =
       (apply direct(f_0 &toplevel)
          ($F : _ -> val)
            (a/1)
            -> k/32 * k/31
          where k/32 (r/2 : val) =
            let $Cell = Block 0 (a/1) in
            cont k/33 pop(k/31) ($Cell)))
    where k/31 exn (e/3 : val) =
      cont k/33 ($Cell))
   where k/33 (p/4 : val) =
     let result/5 = %block_load.[`0`] (p/4) in
     let $camlStatics_scope_bound_after_call = Block 0 (result/5) in
     cont done ($camlStatics_scope_bound_after_call))
