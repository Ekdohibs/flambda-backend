(* For the check of regions: a block that can change is made in a region with
   a block of the same region as its field, which is read through it while the
   region is open. A cell that is made in a region may be made with what is in
   that region; only a cell of the heap is made with nothing local (decision
   D46). The check passes of both terms. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %block.[`0`].my_alloc_region.local[rgn] (x, 1) in
  let p' = %opaque (p) in
  let h = %block.mut.[`0`].my_alloc_region.local[rgn] (p') in
  let c = %opaque (h) in
  let l = %block_load.mut.[`0`] (c) in
  let a = %block_load.[`0`] (l) in
  let u1 = %end_region (rgn) in
  cont k (a)
in
let $camlRegion_cell_made_with_local__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_cell_made_with_local__work_1
     : _ -> imm tagged)
    (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_cell_made_with_local = Block 0 (r) in
    cont done ($camlRegion_cell_made_with_local)
