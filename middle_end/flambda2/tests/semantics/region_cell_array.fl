(* For the check of regions: an array that can change is made in a region, an
   element of it is written, and two elements are read while the region is
   open. The array is a cell, as a block that can change is. The check passes
   of both terms. *)
let code inline(never) loopify(never) size(20)
      work_0 (x : imm tagged)
        my_closure &my_alloc_region my_depth
        -> k * e
        : imm tagged =
  let rgn = %begin_region () in
  let p = %array.`imm`.mut.my_alloc_region.local[rgn] (0, 1, 2) in
  let q = %opaque (p) in
  let w = %array_set.`imm` (q, 0, x) in
  let a = %array_load.`imm`.mut (q, 0) in
  let b = %array_load.`imm`.mut (q, 1) in
  let s = %int_barith.add (a, b) in
  let u1 = %end_region (rgn) in
  cont k (s)
in
let $camlRegion_cell_array__work_1 = closure work_0 @work &toplevel in
apply direct(work_0 &toplevel)
  ($camlRegion_cell_array__work_1 : _ -> imm tagged) (41) -> k1 * error
  where k1 (r : imm tagged) =
    let $camlRegion_cell_array = Block 0 (r) in
    cont done ($camlRegion_cell_array)
