(executables
  (names fldiff fexprc roundtrip flsemantics_main flknownaritylists
   scope_diagnosis_control prefix_fault_control flreaper_main)
  (modes native)
  (libraries
   ocamlfrontend ocamloptcomp
   flambda2 flambda2_compare flambda2_parser flambda2_terms flambda2_cmx
   flambda2_kinds flambda2_numbers flambda2_bound_identifiers
   flambda2_term_basics flambda2_rocq_semantics flambda2_rocq_library
   flambda2_reaper flambda2_datalog flambda2_ui))

;; The program of flsemantics.ml is flsemantics_main.ml; the rules of
;; ../semantics/ run it as flsemantics.exe.
(rule
 (copy flsemantics_main.exe flsemantics.exe))

;; The program of flreaper.ml is flreaper_main.ml; the rules of
;; ../semantics/reaper/ run it as flreaper.exe.
(rule
 (copy flreaper_main.exe flreaper.exe))
